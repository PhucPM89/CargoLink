{
  "ConnectionStrings": {
    "MySql": "server=localhost;port=3306;database=cargolink;user=root;password=YOUR_MYSQL_PASSWORD;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "CargoLink",
    "Audience": "CargoLink.Client",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "ExpirationMinutes": 180
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "cargolink-api",
    "ConsumerGroupId": "cargolink-dispatch",
    "Topics": {
      "NewBooking": "dispatch.booking.created",
      "DriverAccepted": "dispatch.booking.driver-accepted",
      "Completed": "dispatch.booking.completed"
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingIntervalMilliseconds": 1000,
    "LockTimeoutSeconds": 30
  },
  "RedisGeo": {
    "AvailableDriversKey": "drivers:available:geo",
    "NearbySearchTake": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
